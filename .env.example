# .env.example
#
# This project reads NO environment variables and needs NO API keys —
# everything runs fully offline. The .env file is git-ignored, so if you ever
# add one, never commit secrets.
#
# Keys below mirror the CLI flags only as a convenience template for future
# tooling; the Python code does not read them. Set them via CLI instead, e.g.
#   python src/main.py --input ./photos --albums 3 --output ./output

# INPUT_DIR=./photos
# OUTPUT_DIR=./output
# ALBUM_COUNT=3
# PAGE_COUNT=12
# RATIO=16:9
# DPI=300
# STYLE_MODE=auto
# STYLE_STRENGTH=balanced     # mild / balanced / strong
